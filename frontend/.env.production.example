# Environment Variables for Production (Vercel)

# Main Backend API URL - Update this after deploying backend
NEXT_PUBLIC_BACKEND_URL=https://your-backend-url.railway.app

# ML/AI Service API URL - Update this after deploying ML service
NEXT_PUBLIC_ML_SERVICE_URL=https://your-ml-service-url.railway.app

# App Configuration
NEXT_PUBLIC_APP_NAME=AI Content Studio
NEXT_PUBLIC_APP_VERSION=1.0.0
