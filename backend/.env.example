# Environment Variables for Backend

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS - Add your frontend URLs (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# For production, update with your Vercel URL:
# CORS_ORIGIN=https://your-app.vercel.app

# AI API Keys (Add to Render Environment - DO NOT commit real keys)
# Image generation (at least one recommended):
# REPLICATE_API_TOKEN=your_replicate_token  <- free tier, used for img2img too
# HUGGING_FACE_API_KEY=your_hf_token
# SEGMIND_API_KEY=your_segmind_key  <- free tier
# CLIPDROP_API_KEY=your_clipdrop_key
# Chat / Audio / Video:
# OPENAI_API_KEY=your_openai_key
# LTX_API_KEY=your_ltx_key
# OPENROUTER_API_KEY=your_openrouter_key
# RAPIDAPI_KEY=your_rapidapi_key  <- also for background removal, summarization
# ELEVENLABS_API_KEY=your_elevenlabs_key

# File Upload Limits (in MB)
MAX_FILE_SIZE=50
