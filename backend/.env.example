# Environment Variables for Backend

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS - Add your frontend URLs (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# For production, update with your Vercel URL:
# CORS_ORIGIN=https://your-app.vercel.app

# =============================================
# AI API Keys — add to Render / Railway env vars
# =============================================
# At least ONE image key is recommended. Pollinations (free) is always available as fallback.
# Keys marked [FREE] have generous free tiers.

# --- Image Generation (FAST tier — raced simultaneously) ---
# PRODIA_API_KEY=your_prodia_key           # [FREE] prodia.com — flux-fast, no CC needed
# FAL_KEY=your_fal_key                     # [FREE] fal.ai — FLUX schnell, $10 free credit
# DEEPINFRA_API_KEY=your_deepinfra_key     # [FREE] deepinfra.com — FLUX klein, free tier
# TOGETHER_API_KEY=your_together_key       # [FREE] together.ai — FLUX schnell, 3mo free

# --- Image Generation (SLOW tier — sequential fallback) ---
# HUGGING_FACE_API_KEY=your_hf_token       # [FREE] hf.co/settings/tokens — SDXL, FLUX
# REPLICATE_API_TOKEN=your_replicate_token  # [FREE] replicate.com — flux-schnell, SD
# SEGMIND_API_KEY=your_segmind_key         # segmind.com — SDXL
# CLIPDROP_API_KEY=your_clipdrop_key       # clipdrop.co — Stable Diffusion

# --- Chat / LLM (cascading fallback, 7 providers) ---
# OPENROUTER_API_KEY=your_openrouter_key   # openrouter.ai — multi-model router
# OPENAI_API_KEY=your_openai_key           # OpenAI GPT-3.5/4
# GROQ_API_KEY=your_groq_key              # [FREE] groq.com — Llama 3.3, ultra-fast
# (TOGETHER_API_KEY also used for chat)
# (DEEPINFRA_API_KEY also used for chat)
# (HUGGING_FACE_API_KEY also used for chat)
# Pollinations (free, no key) is always the ultimate fallback

# --- Audio / TTS ---
# ELEVENLABS_API_KEY=your_elevenlabs_key   # elevenlabs.io — high-quality voices
# RAPIDAPI_KEY=your_rapidapi_key           # rapidapi.com — voice gen, summarization, bg removal

# --- Video Generation (raced via Promise.race) ---
# LTX_API_KEY=your_ltx_key                # LTX Video
# RUNWAY_API_KEY=your_runway_key           # Runway Gen-2
# PIKA_API_KEY=your_pika_key              # Pika Labs
# GEN2_API_KEY=your_gen2_key              # Runway Gen-2 alternate
# KAIBER_API_KEY=your_kaiber_key          # Kaiber AI
# SYNTHESIA_API_KEY=your_synthesia_key    # Synthesia (avatar videos)
# HEYGEN_API_KEY=your_heygen_key          # HeyGen (avatar videos)
# FAL_VIDEO_KEY= (uses same FAL_KEY)      # Fal.ai AnimateDiff
# (REPLICATE_API_TOKEN also used for video)
# (HUGGING_FACE_API_KEY also used for video)
# Pollinations (free) generates a still frame as fallback

# File Upload Limits (in MB)
MAX_FILE_SIZE=50
