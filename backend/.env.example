# Environment Variables for Backend

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS - Add your frontend URLs (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# For production, update with your Vercel URL:
# CORS_ORIGIN=https://your-app.vercel.app

# AI API Keys (Add these to Render Environment Variables - DO NOT commit real keys)
# OPENAI_API_KEY=your_openai_key_here
# LTX_API_KEY=your_ltx_key_here
# HUGGING_FACE_API_KEY=your_huggingface_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here
# RAPIDAPI_KEY=your_rapidapi_key_here
# DEEPAI_API_KEY=your_deepai_key_here
# CLIPDROP_API_KEY=your_clipdrop_key_here

# File Upload Limits (in MB)
MAX_FILE_SIZE=50
